# Leave empty to use the Vite dev-server proxy (see vite.config.js).
# Set to the gateway origin (no /api suffix) for production builds,
# e.g. http://my-school.com
VITE_API_URL=

# Where the dev-server proxies /api requests (the nginx gateway from docker-compose,
# published on host port 8080 because local Apache holds port 80).
VITE_PROXY_TARGET=http://localhost:8080
